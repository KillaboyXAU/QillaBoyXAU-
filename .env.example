# Copy to .env and fill in. Never commit the real .env file.

# Database
DATABASE_URL=postgres://user:password@localhost:5432/qilla_xau

# Broker (set only when connecting a real adapter — leave blank for simulated/paper mode)
BROKER_NAME=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ENV=paper   # paper | live

# News / economic calendar provider
NEWS_PROVIDER=
NEWS_API_KEY=

# Auth
JWT_SECRET=
SESSION_SECRET=

# App
NODE_ENV=development
LIVE_TRADING_ENABLED=false   # hard-gates LIVE mode regardless of account.mode
